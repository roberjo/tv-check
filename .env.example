# Copy to .env (gitignored) and fill in. Never commit .env.
ROKU_IP=192.168.1.50
ROKU_DEV_USER=rokudev
ROKU_DEV_PASS=<the dev-installer password you set when enabling developer mode>
# Google Calendar → Settings → your calendar → "Secret address in iCal format"
FAMILY_CALENDAR_ICS=https://calendar.google.com/calendar/ical/<id>/private-<secret>/basic.ics
# Optional
GENTLE_NEWS=1
# Only for the shelved voice concierge (attic/concierge/)
ANTHROPIC_API_KEY=
CONCIERGE_TOKEN=
